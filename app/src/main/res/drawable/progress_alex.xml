<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background track with rounded corners -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#33222222" />
        </shape>
    </item>

    <!-- Progress bar with left-to-right gradient and rounded corners -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <gradient
                    android:type="linear"
                    android:angle="0"
					android:startColor="#FF3B30"
					android:centerColor="#FFD54F"
					android:endColor="#8BC34A"
                    android:useLevel="false" />
            </shape>
        </clip>
    </item>

    <!-- Animated sweep overlay (secondary progress) to hint emptying direction -->
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="#40FFFFFF"
                    android:endColor="#00000000"
                    android:useLevel="false" />
            </shape>
        </clip>
    </item>
    
    <!-- Thin outline on top for better visibility -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>


