<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C3000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/tutorialText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Tutorial"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tutorialOk"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="OK"
            app:cornerRadius="12dp"
            android:textColor="@color/white"
            android:background="@drawable/button_gradient_green_blue"
            app:backgroundTint="@null"
            android:textAllCaps="false"/>

    </LinearLayout>

    <!-- Alex image at bottom, half below the screen edge, spanning full width -->
    <ImageView
        android:id="@+id/tutorialImage"
        android:layout_width="match_parent"
        android:layout_height="845dp"
        android:layout_gravity="bottom|center_horizontal"
        android:translationY="350dp"
        android:scaleType="fitCenter"
        android:contentDescription="Alex"/>

</FrameLayout>


