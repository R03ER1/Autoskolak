<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/homeHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#CC000000"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/streakButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="36dp"
            app:icon="@drawable/ic_streak"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconTint="@null"
            android:text="0"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:rippleColor="@color/button_pressed"
            app:backgroundTint="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/xpButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="36dp"
            app:icon="@drawable/ic_coin"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconTint="@null"
            android:text="0"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:rippleColor="@color/button_pressed"
            app:backgroundTint="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/heartsButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="36dp"
            app:icon="@drawable/ic_live"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconTint="@null"
            android:text="0"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:rippleColor="@color/button_pressed"
            app:backgroundTint="@android:color/transparent" />

    </LinearLayout>

    <!-- Page 1 - Alex main content -->
    <FrameLayout
        android:id="@+id/page1Container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp"
        android:layout_marginBottom="56dp">
        
        <!-- Page 1 content will be inflated here -->
    </FrameLayout>

    <!-- Page 2 - Simple overlay (hidden by default) -->
    <FrameLayout
        android:id="@+id/page2Overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp"
        android:layout_marginBottom="56dp"
        android:background="@color/background"
        android:elevation="4dp"
        android:visibility="gone">
        
        <!-- Page 2 content container -->
        <FrameLayout
            android:id="@+id/page2ContentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            
            <!-- Page 2 content will be inflated here -->
        </FrameLayout>

        <!-- Food popup (reusing coin popup style) -->
        <include
            android:id="@+id/foodPopupContainer"
            layout="@layout/coin_popup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="100dp" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:elevation="16dp"
        app:labelVisibilityMode="unlabeled"
        app:itemIconSize="24dp"
        app:itemBackground="?attr/selectableItemBackground"
        app:backgroundTint="@android:color/transparent"
        app:itemActiveIndicatorStyle="@style/Widget.Autokolk.BottomNav.ActiveIndicator"
        app:itemTextAppearanceActive="@style/TextAppearance.Autokolk.BottomNav.Large"
        app:itemTextAppearanceInactive="@style/TextAppearance.Autokolk.BottomNav.Large"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/bottom_nav_menu" />

</FrameLayout>


