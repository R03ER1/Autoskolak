<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alex je v pořádku!"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/alexImage"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="12dp"
        android:contentDescription="Alex"
        android:scaleType="centerInside"
        android:scaleX="1.6"
        android:scaleY="1.6" />

    <TextView
        android:id="@+id/healthProgressLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="31%"
        android:drawablePadding="6dp"
        android:drawableStart="@drawable/ic_food"
        app:drawableTint="@android:color/white"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/hungerFreezeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxWidth="260dp"
        android:text=""
        android:ellipsize="end"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:alpha="0.9"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/healthProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progress="31"
        android:progressDrawable="@drawable/progress_alex" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alexFoodButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center"
            android:text=""
            android:background="@drawable/button_gradient_green_blue"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_food"
            app:iconGravity="start"
            app:iconTint="@android:color/white"
            app:iconPadding="0dp"
            app:iconSize="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alexShopButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center"
            android:text=""
            android:background="@drawable/button_gradient_green_blue"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_shop"
            app:iconGravity="start"
            app:iconTint="@android:color/white"
            app:iconPadding="0dp"
            app:iconSize="28dp" />
    </LinearLayout>

</LinearLayout>



