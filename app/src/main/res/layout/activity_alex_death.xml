<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="120dp">

        <TextView
            android:id="@+id/deathTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ ALEX VYHLADOVĚL... ⚠️"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:textAllCaps="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/red_striped_line" />

        <ImageView
            android:id="@+id/deadLionImage"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Dead lion"
            android:scaleType="centerInside"
            android:scaleX="1.4"
            android:scaleY="1.4" />

        <TextView
            android:id="@+id/deathMessage1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Čekal na tebe opravdu dlouho, ale hlad byl prostě silnější než jeho trpělivost."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:maxWidth="320dp" />

        <TextView
            android:id="@+id/deathMessage2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teď spí — hlubokým spánkem, ze kterého ho může probudit jen ten, komu na něm opravdu záleží."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:maxWidth="320dp" />

        <TextView
            android:id="@+id/deathMessage3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Podrž prst na obrazovce, abys dostal druhou šanci. Ale zároveň se zavazuješ, že se o něj příště postaráš lépe."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:maxWidth="320dp" />

    </LinearLayout>

    <!-- Hold button fixed at bottom center -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:paddingBottom="32dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/holdButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_fingerprint"
            android:background="@drawable/fingerprint_button_fill"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Hold to revive" />

        <TextView
            android:id="@+id/holdProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="100dp"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </FrameLayout>

</FrameLayout>

