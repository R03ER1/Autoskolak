<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Úspěchy"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Za každý splněný úspěch získáš 150 bodů."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:alpha="0.8"
            android:layout_marginBottom="12dp"/>

        <!-- Streak -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Streak"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/star_streak_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666"/>
                        <ImageView android:id="@+id/star_streak_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                        <ImageView android:id="@+id/star_streak_3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/progress_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/5" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fixes -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chyby – opravy"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/star_fixes_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666"/>
                        <ImageView android:id="@+id/star_fixes_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                        <ImageView android:id="@+id/star_fixes_3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/progress_fixes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/20" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Correct answers -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Otázky – správně zodpovězeno"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/star_correct_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666"/>
                        <ImageView android:id="@+id/star_correct_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                        <ImageView android:id="@+id/star_correct_3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/progress_correct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/100" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Coins earned -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Penízky – získané"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/star_earned_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666"/>
                        <ImageView android:id="@+id/star_earned_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                        <ImageView android:id="@+id/star_earned_3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/progress_earned" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/50" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Coins spent -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Penízky – utracené"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/star_spent_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666"/>
                        <ImageView android:id="@+id/star_spent_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                        <ImageView android:id="@+id/star_spent_3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/progress_spent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/150" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Alex feed streak -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex – streak krmení"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/star_feed_streak_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666"/>
                        <ImageView android:id="@+id/star_feed_streak_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                        <ImageView android:id="@+id/star_feed_streak_3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/progress_feed_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/10" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Food items -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex – mrkev"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/star_food_mrkev_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666"/>
                        <ImageView android:id="@+id/star_food_mrkev_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                        <ImageView android:id="@+id/star_food_mrkev_3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/progress_food_mrkev" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/60" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex – zmrzlina"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/star_food_zmrzlina_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666"/>
                        <ImageView android:id="@+id/star_food_zmrzlina_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                        <ImageView android:id="@+id/star_food_zmrzlina_3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/progress_food_zmrzlina" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/90" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex – kuře"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/star_food_kure_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666"/>
                        <ImageView android:id="@+id/star_food_kure_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                        <ImageView android:id="@+id/star_food_kure_3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/progress_food_kure" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/30" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex – klobás"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/star_food_klobaska_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666"/>
                        <ImageView android:id="@+id/star_food_klobaska_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                        <ImageView android:id="@+id/star_food_klobaska_3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/progress_food_klobaska" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/250" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex – pivo"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/star_food_pivo_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666"/>
                        <ImageView android:id="@+id/star_food_pivo_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                        <ImageView android:id="@+id/star_food_pivo_3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/progress_food_pivo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/5" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_dark">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex – kamení"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/star_food_kameni_1" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666"/>
                        <ImageView android:id="@+id/star_food_kameni_2" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                        <ImageView android:id="@+id/star_food_kameni_3" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:tint="#666666" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/progress_food_kameni" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/5" android:textColor="@color/text_primary" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
