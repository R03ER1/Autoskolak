<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/shopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doplňky pro Alexe"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

		<LinearLayout
			android:id="@+id/accessory_sunglasses"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:background="@drawable/item_background_selector"
			android:padding="16dp"
			android:orientation="horizontal"
			android:gravity="center_vertical">

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:text="Sluneční brýle"
					android:textColor="@color/text_primary"
					android:textSize="18sp"
					android:textStyle="bold" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:gravity="center_horizontal"
					android:text="Sluneční brýle – 1 000 bodů"
					android:textColor="@color/text_primary"
					android:textSize="16sp" />
			</LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/toggle_sunglasses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:theme="@style/ThemeOverlay.Autokolk.SwitchNeutral"
                android:text="Zapnout"
                android:textAllCaps="false"
                android:visibility="gone"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"
                app:rippleColor="@color/button_pressed"
                app:useMaterialThemeColors="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buy_sunglasses_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Koupit"
                android:textColor="@color/white"
                android:background="@drawable/button_gradient_green_blue"
                app:backgroundTint="@null"
                android:textAllCaps="false" />
        </LinearLayout>

		<LinearLayout
			android:id="@+id/accessory_rename"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:background="@drawable/item_background_selector"
			android:padding="16dp"
			android:orientation="horizontal"
			android:gravity="center_vertical">

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:text="Přejmenovat Alexe"
					android:textColor="@color/text_primary"
					android:textSize="18sp"
					android:textStyle="bold" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:gravity="center_horizontal"
					android:text="Odemknout přejmenování – 2 000 bodů"
					android:textColor="@color/text_primary"
					android:textSize="16sp" />
			</LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rename_feature_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Koupit"
                android:textColor="@color/white"
                android:background="@drawable/button_gradient_green_blue"
                app:backgroundTint="@null"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>


