<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Fixed top header -->
    <LinearLayout
        android:id="@+id/homeHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#CC000000"
        android:elevation="8dp">

        <!-- Removed app title to only show streak, points, hearts -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/streakButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="36dp"
            app:icon="@drawable/ic_streak"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconTint="@null"
            android:text="0"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:rippleColor="@color/button_pressed"
            app:backgroundTint="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/xpButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="36dp"
            app:icon="@drawable/ic_coin"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconTint="@null"
            android:text="0"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:rippleColor="@color/button_pressed"
            app:backgroundTint="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/heartsButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="36dp"
            app:icon="@drawable/ic_live"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconTint="@null"
            android:text="0"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:rippleColor="@color/button_pressed"
            app:backgroundTint="@android:color/transparent" />

    </LinearLayout>

    <!-- Scrollable content below header -->
    <ScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp"
        android:layout_marginBottom="56dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/lessonButtonsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">
                <!-- Lesson buttons will be added here dynamically -->
            </LinearLayout>

            

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:labelVisibilityMode="unlabeled"
        app:itemIconSize="24dp"
        app:itemBackground="?attr/selectableItemBackground"
        app:backgroundTint="@android:color/transparent"
        app:itemActiveIndicatorStyle="@style/Widget.Autokolk.BottomNav.ActiveIndicator"
        app:itemTextAppearanceActive="@style/TextAppearance.Autokolk.BottomNav.Large"
        app:itemTextAppearanceInactive="@style/TextAppearance.Autokolk.BottomNav.Large"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/bottom_nav_menu" />

</FrameLayout>