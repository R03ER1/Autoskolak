<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:targetApi="33" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Autokolk.NoActionBar"
        tools:targetApi="31">
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".ResultsActivity"
            android:exported="false" />
        <activity
            android:name=".StreakActivity"
            android:exported="false" />
        <activity
            android:name=".ReadingLessonActivity"
            android:exported="false"
            android:theme="@style/Theme.Autokolk.NoActionBar" />
        <activity
            android:name=".AlexActivity"
            android:exported="false"
            android:theme="@style/Theme.Autokolk.NoActionBar" />
        <activity
            android:name=".PracticeActivity"
            android:exported="false"
            android:theme="@style/Theme.Autokolk.NoActionBar" />
        <activity
            android:name=".TestAttemptActivity"
            android:exported="false"
            android:theme="@style/Theme.Autokolk.NoActionBar" />
        <activity
            android:name=".TestAttemptStatsActivity"
            android:exported="false"
            android:theme="@style/Theme.Autokolk.NoActionBar" />
        <activity
            android:name=".TestResultsActivity"
            android:exported="false"
            android:theme="@style/Theme.Autokolk.NoActionBar" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Autokolk.NoActionBar" />
        <activity
            android:name=".AchievementsActivity"
            android:exported="false"
            android:theme="@style/Theme.Autokolk.NoActionBar" />
        <activity
            android:name=".ChangelogActivity"
            android:exported="false"
            android:theme="@style/Theme.Autokolk.NoActionBar" />

        <service
            android:name=".HeartRefillJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".HungerNotificationService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>